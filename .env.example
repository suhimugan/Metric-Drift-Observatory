# .env.example
# Copy to .env and fill in for local/CLI tooling only.
# .env is git-ignored — never commit the real file.
# In Databricks itself, prefer Key Vault-backed secret scopes over .env files.

AZURE_STORAGE_ACCOUNT=<your_storage_account>
AZURE_TENANT_ID=<your_tenant_id>
DATABRICKS_HOST=<your_databricks_workspace_url>
DATABRICKS_TOKEN=<use a Databricks secret scope instead of storing this here>
